<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.aaa.dao.OrdersDao">

    <resultMap id="orderMapper" type="Orders">
        <id     column="order_id"    property="id"/>
        <result column="order_no"    property="no"/>
        <result column="order_price" property="price"/>
    </resultMap>

    <select id="getByNo" resultMap="orderMapper">
        select * from orders where order_no = #{no}
    </select>

    <select id="getAll" resultMap="orderMapper">
        select * from orders
    </select>

    <select id="getAllByAlias" resultType="Orders">
        select order_id    as id,
               order_no    as no,
               order_price as price
        from orders
    </select>

</mapper>